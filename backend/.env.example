# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/uniqlo_line_monitor

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Secret key for hashing client IPs (rate limiting). Raw IPs are never stored.
# Generate with: openssl rand -hex 32
# If unset, a random key is generated on each start.
IP_HASH_SECRET=change_me
